#!/usr/bin/env bash

set -u

ROOT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
source "$ROOT_DIR/tokens" || exit 1

usage() {
  cat <<'USAGE'
Usage: ./dev <start|stop|reset|test> [lms|sis|all]

Targets default to all:
  lms  Learning management system (http://127.0.0.1:3000)
  sis  Student information system (http://127.0.0.1:3001)
  acme Acme Guess the Number tool (http://127.0.0.1:3002)
  all  All applications

Reset stops the selected app(s), resets their development databases, and
starts them again. The Acme tool has no database to reset. Test runs the
selected app's test suite.
USAGE
}

app_dir() {
  if [ "$1" = acme ]; then
    printf '%s/tools/acme' "$ROOT_DIR"
  else
    printf '%s/%s' "$ROOT_DIR" "$1"
  fi
}

app_port() {
  case "$1" in
    lms) printf '3000' ;;
    sis) printf '3001' ;;
    acme) printf '3002' ;;
  esac
}

pid_file() {
  printf '%s/tmp/pids/lms-standards-dev.pid' "$(app_dir "$1")"
}

log_file() {
  printf '%s/log/root-dev-server.log' "$(app_dir "$1")"
}

ensure_lti_keys() {
  local key_dir="$ROOT_DIR/.local/lti"
  local platform_key="$key_dir/platform.pem"
  local tool_key="$key_dir/acme-tool.pem"
  local key

  for key in "$ROOT_DIR/.local" "$key_dir" "$platform_key" "$tool_key"; do
    if [ -L "$key" ]; then
      printf 'Refusing to use a symbolic link for local LTI key path: %s\n' "$key" >&2
      return 1
    fi
  done
  mkdir -p -- "$key_dir" || return 1
  chmod 700 -- "$key_dir" || return 1

  for key in "$platform_key" "$tool_key"; do
    if [ -e "$key" ] && [ ! -f "$key" ]; then
      printf 'Refusing to use a non-file local LTI key path: %s\n' "$key" >&2
      return 1
    fi
    if [ ! -e "$key" ]; then
      if ! (umask 077 && openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out "$key"); then
        printf 'Unable to generate local LTI key at %s.\n' "$key" >&2
        return 1
      fi
    fi
    chmod 600 -- "$key" || return 1
    openssl pkey -check -noout -in "$key" >/dev/null 2>&1 || {
      printf 'Invalid local LTI private key at %s.\n' "$key" >&2
      return 1
    }
  done

  export LTI_PLATFORM_PRIVATE_KEY_PATH="$platform_key"
  export LTI_TOOL_PRIVATE_KEY_PATH="$tool_key"
}

pid_is_app_server() {
  local pid=$1
  local directory=$2
  local process_command

  process_command=$(ps -p "$pid" -o command= 2>/dev/null) || return 1
  case "$process_command" in
    *"rails server"*|*puma*) ;;
    *) return 1 ;;
  esac

  if [ -e "/proc/$pid/cwd" ]; then
    local process_directory
    process_directory=$(readlink -f "/proc/$pid/cwd" 2>/dev/null) || return 1
    [ "$process_directory" = "$directory" ]
  else
    case "$process_command" in
      *"$directory"*) return 0 ;;
      *) return 1 ;;
    esac
  fi
}

start_app() {
  local app=$1
  local directory
  local port
  local pidfile
  local logfile
  local launcher_pid
  local server_pid
  local attempt
  local oneroster_client_id
  local oneroster_client_secret
  local lti_platform_key
  local lti_tool_key

  directory=$(app_dir "$app")
  port=$(app_port "$app")
  pidfile=$(pid_file "$app")
  logfile=$(log_file "$app")
  if [ "$app" = lms ]; then
    oneroster_client_id=$LMS_ONEROSTER_CLIENT_ID
    oneroster_client_secret=$LMS_ONEROSTER_CLIENT_SECRET
  elif [ "$app" = sis ]; then
    oneroster_client_id=$SIS_ONEROSTER_CLIENT_ID
    oneroster_client_secret=$SIS_ONEROSTER_CLIENT_SECRET
  else
    oneroster_client_id=""
    oneroster_client_secret=""
  fi
  lti_platform_key=${LTI_PLATFORM_PRIVATE_KEY_PATH:-"$ROOT_DIR/.local/lti/platform.pem"}
  lti_tool_key=${LTI_TOOL_PRIVATE_KEY_PATH:-"$ROOT_DIR/.local/lti/acme-tool.pem"}

  if [ "$app" = lms ] && ! prepare_lms_start; then
    return 1
  fi

  if [ -f "$pidfile" ]; then
    server_pid=$(<"$pidfile")
    if [[ "$server_pid" =~ ^[0-9]+$ ]] && kill -0 "$server_pid" 2>/dev/null; then
      if pid_is_app_server "$server_pid" "$directory"; then
        printf '%s is already running at http://127.0.0.1:%s\n' "$app" "$port"
        return 0
      fi
      printf 'Refusing to start %s: PID file points to an active, unrelated process (%s).\n' "$app" "$server_pid" >&2
      return 1
    fi
    rm -f -- "$pidfile"
  fi

  mkdir -p -- "$(dirname -- "$pidfile")" || {
    printf 'Unable to create PID directory for %s.\n' "$app" >&2
    return 1
  }
  mkdir -p -- "$(dirname -- "$logfile")" || {
    printf 'Unable to create log directory for %s.\n' "$app" >&2
    return 1
  }

  cd -- "$directory" || {
    printf 'Unable to enter %s directory: %s\n' "$app" "$directory" >&2
    return 1
  }
  if [ "$app" = acme ]; then
    nohup env PORT="$port" LTI_PLATFORM_ISSUER="${LTI_PLATFORM_ISSUER:-http://127.0.0.1:3000}" \
      LTI_PLATFORM_PRIVATE_KEY_PATH="$lti_platform_key" LTI_TOOL_PRIVATE_KEY_PATH="$lti_tool_key" \
      LTI_TOOL_BASE_URL="${LTI_TOOL_BASE_URL:-http://127.0.0.1:3002}" \
      LTI_TOOL_CLIENT_ID="${LTI_TOOL_CLIENT_ID:-acme-guess-the-number}" \
      LTI_DEPLOYMENT_ID="${LTI_DEPLOYMENT_ID:-local-acme}" \
      bundle exec puma config.ru --bind "tcp://127.0.0.1:$port" --pidfile "$pidfile" >>"$logfile" 2>&1 </dev/null &
  else
    nohup env PORT="$port" PIDFILE="$pidfile" ONEROSTER_CLIENT_ID="$oneroster_client_id" \
      ONEROSTER_CLIENT_SECRET="$oneroster_client_secret" \
      LTI_PLATFORM_ISSUER="${LTI_PLATFORM_ISSUER:-http://127.0.0.1:3000}" \
      LTI_PLATFORM_PRIVATE_KEY_PATH="$lti_platform_key" LTI_TOOL_PRIVATE_KEY_PATH="$lti_tool_key" \
      LTI_TOOL_BASE_URL="${LTI_TOOL_BASE_URL:-http://127.0.0.1:3002}" \
      LTI_TOOL_CLIENT_ID="${LTI_TOOL_CLIENT_ID:-acme-guess-the-number}" \
      LTI_DEPLOYMENT_ID="${LTI_DEPLOYMENT_ID:-local-acme}" \
      bundle exec rails server --binding 127.0.0.1 >>"$logfile" 2>&1 </dev/null &
  fi
  launcher_pid=$!
  cd -- "$ROOT_DIR" || return 1

  for ((attempt = 0; attempt < 50; attempt++)); do
    if [ -f "$pidfile" ]; then
      server_pid=$(<"$pidfile")
      if [[ "$server_pid" =~ ^[0-9]+$ ]] && pid_is_app_server "$server_pid" "$directory"; then
        printf '%s started at http://127.0.0.1:%s (PID %s)\n' "$app" "$port" "$server_pid"
        return 0
      fi
    fi
    if ! kill -0 "$launcher_pid" 2>/dev/null; then
      break
    fi
    sleep 0.2
  done

  printf 'Failed to start %s. Recent server output from %s:\n' "$app" "$logfile" >&2
  if [ -f "$logfile" ]; then
    tail -n 20 -- "$logfile" >&2
  fi
  return 1
}

stop_app() {
  local app=$1
  local directory
  local pidfile
  local server_pid
  local attempt

  directory=$(app_dir "$app")
  pidfile=$(pid_file "$app")
  if [ ! -f "$pidfile" ]; then
    printf '%s is not running.\n' "$app"
    return 0
  fi

  server_pid=$(<"$pidfile")
  if ! [[ "$server_pid" =~ ^[0-9]+$ ]]; then
    printf 'Cannot stop %s: invalid PID file %s.\n' "$app" "$pidfile" >&2
    return 1
  fi
  if ! kill -0 "$server_pid" 2>/dev/null; then
    rm -f -- "$pidfile"
    printf 'Removed stale PID file for %s; it was not running.\n' "$app"
    return 0
  fi
  if ! pid_is_app_server "$server_pid" "$directory"; then
    printf 'Refusing to stop %s: PID %s is not its Rails server.\n' "$app" "$server_pid" >&2
    return 1
  fi

  kill -TERM "$server_pid" || {
    printf 'Unable to send stop signal to %s (PID %s).\n' "$app" "$server_pid" >&2
    return 1
  }
  for ((attempt = 0; attempt < 50; attempt++)); do
    if ! kill -0 "$server_pid" 2>/dev/null; then
      rm -f -- "$pidfile"
      printf '%s stopped.\n' "$app"
      return 0
    fi
    if ! pid_is_app_server "$server_pid" "$directory"; then
      rm -f -- "$pidfile"
      printf '%s stopped.\n' "$app"
      return 0
    fi
    sleep 0.2
  done

  printf '%s did not stop within 10 seconds (PID %s).\n' "$app" "$server_pid" >&2
  return 1
}

prepare_lms_start() {
  local directory
  local pidfile
  local server_pid
  local migration_status

  directory=$(app_dir lms)
  pidfile=$(pid_file lms)
  if ! migration_status=$(cd -- "$directory" && bin/rails db:migrate:status 2>&1); then
    printf 'Unable to check LMS migrations:\n%s\n' "$migration_status" >&2
    return 1
  fi

  if grep -Eq '^[[:space:]]*down[[:space:]]' <<<"$migration_status"; then
    if [ -f "$pidfile" ]; then
      server_pid=$(<"$pidfile")
      if [[ "$server_pid" =~ ^[0-9]+$ ]] && kill -0 "$server_pid" 2>/dev/null; then
        if ! pid_is_app_server "$server_pid" "$directory"; then
          printf 'Refusing to migrate the LMS while its PID file points to an unrelated process (%s).\n' "$server_pid" >&2
          return 1
        fi
        stop_app lms || return 1
      fi
    fi

    printf 'Applying pending LMS database migrations...\n'
    if ! (cd -- "$directory" && bin/rails db:migrate); then
      printf 'LMS migrations failed; the LMS was not started.\n' >&2
      return 1
    fi
  fi

  if [ -f "$pidfile" ] && [ -f "$directory/db/schema.rb" ] && [ "$directory/db/schema.rb" -nt "$pidfile" ]; then
    server_pid=$(<"$pidfile")
    if [[ "$server_pid" =~ ^[0-9]+$ ]] && kill -0 "$server_pid" 2>/dev/null; then
      if ! pid_is_app_server "$server_pid" "$directory"; then
        printf 'Refusing to restart the LMS: PID file points to an unrelated process (%s).\n' "$server_pid" >&2
        return 1
      fi
      printf 'Restarting LMS to reload the updated database schema.\n'
      stop_app lms || return 1
    fi
  fi
}

test_app() {
  local app=$1
  local directory

  directory=$(app_dir "$app")
  printf 'Running %s tests...\n' "$app"
  if [ "$app" = acme ]; then
    if ! (cd -- "$directory" && bundle exec ruby test/app_test.rb); then
      printf 'Tests failed for %s.\n' "$app" >&2
      return 1
    fi
  elif ! (cd -- "$directory" && bin/rails test); then
    printf 'Tests failed for %s.\n' "$app" >&2
    return 1
  fi
}

if [ "$#" -lt 1 ] || [ "$#" -gt 2 ]; then
  usage >&2
  exit 2
fi

action=$1
target=${2:-all}
case "$action" in
  start|stop|reset|test) ;;
  *)
    usage >&2
    exit 2
    ;;
esac

case "$target" in
  all) apps=(lms sis acme) ;;
  lms|sis|acme) apps=("$target") ;;
  *)
    usage >&2
    exit 2
    ;;
esac

case "$action" in
  start)
    if [[ " ${apps[*]} " == *" lms "* || " ${apps[*]} " == *" acme "* ]]; then
      ensure_lti_keys || exit 1
    fi
    status=0
    for app in "${apps[@]}"; do
      start_app "$app" || status=1
    done
    exit "$status"
    ;;
  stop)
    status=0
    for app in "${apps[@]}"; do
      stop_app "$app" || status=1
    done
    exit "$status"
    ;;
  reset)
    if [[ " ${apps[*]} " == *" lms "* || " ${apps[*]} " == *" acme "* ]]; then
      ensure_lti_keys || exit 1
    fi
    status=0
    for app in "${apps[@]}"; do
      stop_app "$app" || status=1
    done
    if [ "$status" -ne 0 ]; then
      printf 'Reset aborted because one or more apps could not be stopped.\n' >&2
      exit "$status"
    fi
    for app in "${apps[@]}"; do
      if [ "$app" = acme ]; then
        continue
      fi
      directory=$(app_dir "$app")
      printf 'Resetting %s development database...\n' "$app"
      if ! (cd -- "$directory" && bin/rails db:reset); then
        printf 'Database reset failed for %s; selected apps were left stopped.\n' "$app" >&2
        exit 1
      fi
    done
    for app in "${apps[@]}"; do
      if [ "$app" = acme ]; then
        continue
      fi
      start_app "$app" || status=1
    done
    exit "$status"
    ;;
  test)
    status=0
    for app in "${apps[@]}"; do
      test_app "$app" || status=1
    done
    exit "$status"
    ;;
esac
