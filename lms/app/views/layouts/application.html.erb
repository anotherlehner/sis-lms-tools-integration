<!DOCTYPE html>
<html>
  <head>
    <title>Simple LMS</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "application" %>
  </head>

  <body>
    <header class="site-header">
      <%= link_to "Simple LMS", root_path, class: "brand" %>
      <% if current_user %>
        <nav>
          <span><%= current_user.full_name %> (<%= current_user.role_names.join(", ") %>)</span>
          <% if current_user.admin? %>
            <%= link_to "Admin", rails_admin_path %>
          <% end %>
          <%= button_to "Sign out", logout_path, method: :delete, class: "link-button" %>
        </nav>
      <% end %>
    </header>
    <main class="container">
      <% flash.each do |type, message| %>
        <p class="flash <%= type %>"><%= message %></p>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
