<p><%= link_to "Back to course", course_section_path(@course, @section) %></p>
<h1>Gradebook: <%= @course.title %></h1>
<p class="muted"><%= @section.name %></p>

<% if @grade_errors.present? %>
  <div class="flash alert">
    <ul>
      <% @grade_errors.each do |error| %>
        <li><%= error %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<section class="panel table-scroll">
  <% if @students.any? %>
    <%= form_with url: course_section_gradebook_path(@course, @section), method: :patch do %>
      <table>
        <thead>
          <tr>
            <th>Student</th>
            <th>Midterm</th>
            <th>Final</th>
            <% @activities.each do |activity| %>
              <th><%= activity.title %></th>
            <% end %>
          </tr>
        </thead>
        <tbody>
          <% @students.each do |student| %>
            <% section_grade = @section_grades[student.id] %>
            <tr>
              <th><%= student.full_name %></th>
              <td>
                <%= number_field_tag "grades[#{student.id}][midterm_grade]",
                  section_grade&.midterm_grade, min: 0, max: 100, step: 0.01,
                  aria: { label: "#{student.full_name} midterm grade" } %>
              </td>
              <td>
                <%= number_field_tag "grades[#{student.id}][final_grade]",
                  section_grade&.final_grade, min: 0, max: 100, step: 0.01,
                  aria: { label: "#{student.full_name} final grade" } %>
              </td>
              <% @activities.each do |activity| %>
                <% completion = @activity_completions[[student.id, activity.id]] %>
                <td>
                  <span class="muted"><%= completion&.completed_at ? "Complete" : "Incomplete" %></span>
                  <% if completion&.attempt_count.present? %>
                    <p class="muted">Solved in <%= completion.attempt_count %>
                      <%= "guess".pluralize(completion.attempt_count) %></p>
                  <% end %>
                  <%= number_field_tag "activity_grades[#{student.id}][#{activity.id}][score]",
                    completion&.score, min: 0, max: 100, step: 0.01,
                    aria: { label: "#{student.full_name} #{activity.title} grade" } %>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
      <%= submit_tag "Save grades" %>
    <% end %>
  <% else %>
    <p>No students are enrolled in this section.</p>
  <% end %>
</section>
